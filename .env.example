# Copy to .env and adjust
APP_API_KEY=
APP_MAX_PAGE_SIZE=100

# Storage: set APP_DATABASE_URL to use PostgreSQL; leave it empty to use the CSV file
APP_DATABASE_URL=postgresql+psycopg://app:localdev@localhost:5432/records
# CSV used when APP_DATABASE_URL is empty, and to seed an empty database
APP_CSV_PATH=data/employees.csv
APP_SEED_CSV=data/employees.csv
